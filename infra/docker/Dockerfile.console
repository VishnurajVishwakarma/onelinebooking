FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY src ./src
COPY apps/console ./apps/console
RUN npm --prefix apps/console ci && npm --prefix apps/console run build

FROM node:22-alpine AS runtime
WORKDIR /app/apps/console
ENV NODE_ENV=production
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/src /app/src
COPY --from=builder /app/apps/console/.next ./.next
COPY --from=builder /app/apps/console/package*.json ./
COPY --from=builder /app/apps/console/node_modules ./node_modules
USER node
EXPOSE 3000
CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]


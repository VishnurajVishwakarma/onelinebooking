FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json tsconfig.json ./
RUN npm ci
COPY src ./src
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
COPY src/infrastructure/postgres/migrations ./src/infrastructure/postgres/migrations
USER node
EXPOSE 4100
CMD ["node", "dist/src/platform/bin/run-api.js"]

